{
  "name": "gemini-proxy",
  "version": "1.0.0",
  "description": "Pure Cloudflare Worker Claude-to-Gemini API proxy",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "deploy": "npm run build:frontend && wrangler deploy",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.0"
  }
}
