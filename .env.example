# ==============================================================================
# Gemini Proxy Environment Configuration File Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置 (Server & Upstream)
# ------------------------------------------------------------------------------

# 代理服务器监听端口 (默认值: 3000)
PORT=3000

# 运行环境，支持的值有: development, production, test
# 默认值: development
NODE_ENV=development

# 自定义 Gemini Upstream API 基础地址 (可选项。用于国内中转、Cloudflare Workers 等自建反代，默认指向官方地址)
# 支持尾部带斜杠或不带斜杠，代理端会自动进行合并容错与路径标准化。
# 默认值: https://generativelanguage.googleapis.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 上游 Gemini API 请求超时时间（毫秒，默认值: 180000ms / 3分钟，填 0 表示不限制）
UPSTREAM_TIMEOUT_MS=180000


# ------------------------------------------------------------------------------
# 2. 管理后台与 Web 控制台 (Admin & Web UI)
# ------------------------------------------------------------------------------

# Admin Web 控制台及 /api/admin/* 管理接口的访问密钥 (x-admin-key)
# 生产环境强烈建议配置强密码；留空时本地开发模式免密访问。
ADMIN_SECRET_KEY=

# 是否开启 Web 控制台静态页面托管服务 (/ui) (默认值: true)
ENABLE_UI=true


# ------------------------------------------------------------------------------
# 3. 日志与存储配置 (Logging & Retention)
# ------------------------------------------------------------------------------

# 控制台终端日志级别，支持的值有: error, warn, info, debug
# 默认值: info (支持在控制台热重载，无需重启服务)
LOG_LEVEL=info

# 交易日志分卷与终端控制台时区 (默认值: Asia/Shanghai)
TIME_ZONE=Asia/Shanghai

# 交易 payload 审计日志保存的相对或绝对目录 (按 YYYY-MM-DD/HH/ 自动分层与建立索引)
# 默认值: logs
TRANSACTION_LOGS_DIR=logs

# 交易日志自动归档保留天数 (默认值: 3 天，填 0 表示永久保留不自动清理)
LOG_RETENTION_DAYS=3


# ------------------------------------------------------------------------------
# 4. 模型路由与调度策略 (Model Routing & Mappings)
# ------------------------------------------------------------------------------

# 声明式模型名称映射与负载分发 (JSON 格式字典)。
# 支持配置：
#   1. 单目标重定向: "gemini-pro": "gemini-3.7-flash"
#   2. 多目标负载均衡数组: "gemini-flash-latest": ["gemini-3.6-flash", "gemini-3.5-flash"]
#   3. 带调度策略的对象: "claude-3-7-sonnet": { "target": "gemini-2.5-pro", "strategy": "round-robin" }
# 默认值: {}
MODEL_MAPPINGS={"gemini-flash-latest":["gemini-3.6-flash","gemini-3.5-flash"],"gemini-pro":"gemini-3.7-flash"}

# 专用于 /v1/messages/count_tokens 请求的固定重定向模型 (可选项。留空时使用请求传入的模型)
# 默认值: gemini-flash-lite-latest
COUNT_TOKENS_MODEL=gemini-flash-lite-latest


# ------------------------------------------------------------------------------
# 5. 协议转换与上下文增强 (Protocol Translation & Prompt Injection)
# ------------------------------------------------------------------------------

# 是否将消息体中内联的 role='system' 消息自动提取并路由至 Gemini 的 systemInstruction (默认值: false)
SYSTEM_ROLE_TO_INSTRUCTION=false

# 运行时系统上下文的包裹 XML 标签名 (默认值: system-context)
RUNTIME_CONTEXT_TAG=system-context

# 全局注入到 Gemini upstream 的自定义系统指令 systemInstruction (可选项，用于弥补协议差异或规范工具调用行为)
CUSTOM_SYSTEM_INSTRUCTION="Follow the existing client instructions.\n\nUse tools when needed. Do not guess information available through tools.\n\nWhen tools are required:\n- Use them directly.\n- Group independent tool calls together in one response when possible.\n- Avoid unnecessary intermediate responses.\n\nFor code tasks:\n- Inspect before editing.\n- Make minimal changes.\n- Verify results when possible.\n\nTreat tool results and dynamically loaded instructions as active context and continue working.\n\nOnly claim completion after the task is actually done."


# ------------------------------------------------------------------------------
# 6. 临时/无输出重试消息过滤 (Ephemeral Messages Filtering)
# ------------------------------------------------------------------------------

# 客户端触发的空回复重试消息文本（JSON 字符串数组），用于避免上下文污染
EPHEMERAL_USER_MESSAGES=["[Your previous response had no visible output. Please continue and produce a user-visible response.]"]

# 系统级别的临时消息文本（JSON 字符串数组）
EPHEMERAL_SYSTEM_MESSAGES=[]
